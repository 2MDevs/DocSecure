# ==============================================================================
# DOCSECURE ENTERPRISE - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. BANCO DE DADOS (PostgreSQL na VPS local)
# Porta customizada recomendada (ex: 3030). Substitua SENHA_AQUI pela senha segura da VPS.
DATABASE_URL="postgresql://docsecure_user:SENHA_AQUI@localhost:3030/docsecure_db?schema=public"

# 2. CRIPTOGRAFIA DE SEGREDOS & VARIÁVEIS DO SISTEMA (AES-256-GCM)
# Chave de 32 bytes em base64 utilizada para encriptar segredos em system_settings (SMTP_PASS, GEMINI_API_KEY).
# Gere sua chave no terminal com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY="COLOQUE_AQUI_SUA_CHAVE_BASE64_DE_32_BYTES"

# 3. CONTROLE DE DESENVOLVEDORES (Acesso exclusivo à tela Integração & /api/integrations/*)
# Lista de e-mails autorizados separados por vírgula. Na inicialização, estes usuários recebem o papel DEVELOPER.
DEVELOPER_EMAILS="marcosmonteiro.devs@gmail.com,admin@docsecure.io"

# 4. AMBIENTE & REDE
PORT=3000
NODE_ENV=production
APP_URL="https://seu-dominio.com.br"

# 5. SEGURANÇA & SESSÃO (Valores padrão - configuráveis também via tela Integração)
# Validade da sessão em horas (renovada automaticamente pelo uso, mín 1, máx 72)
SESSION_TTL_HOURS=8
# Limite máximo para upload multipart de arquivos em Megabytes (mín 1, máx 500)
MAX_UPLOAD_MB=25

# 6. ADMINISTRADOR INICIAL (Criado automaticamente se o banco estiver vazio)
# A senha inicial será criptografada com bcrypt (custo 12).
# Troca de senha obrigatória no primeiro login.
ADMIN_EMAIL="admin@seu-dominio.com.br"
ADMIN_INITIAL_PASSWORD="DefinaSuaSenhaSeguraCom10+Chars123"

# 7. SERVIDOR DE E-MAIL (SMTP - Valores padrão opcionais, configuráveis via tela Integração)
SMTP_HOST="smtp.seu-provedor.com.br"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="notificacoes@seu-dominio.com.br"
SMTP_PASS="SENHA_DO_EMAIL_AQUI"
SMTP_FROM="DocSecure Enterprise <notificacoes@seu-dominio.com.br>"

# 8. INTELIGÊNCIA ARTIFICIAL (Opcional - Google Gemini, configurável via tela Integração)
GEMINI_API_KEY="SUA_CHAVE_GEMINI_AQUI"
